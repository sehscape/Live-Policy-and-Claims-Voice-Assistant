# GEMINI_API_KEY: Required. Used only server-side (see api/_shared/gemini.ts)
# to call the Gemini API and to mint short-lived Live API session tokens.
# Never sent to or stored in the browser. Get a free-tier key from
# https://aistudio.google.com/ and set it here for local dev, or as a
# Vercel Environment Variable for deployment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
